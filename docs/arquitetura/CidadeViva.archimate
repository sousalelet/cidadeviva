  <folder name="Technology &amp; Physical" id="id-99412c0a38304c3bacb175e21fdb29fa" type="technology"/>
  <folder name="Motivation" id="id-73bf152340e942b7837832051a90aad9" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Cidadão" id="id-7ba6b842ba924e97b4dc8cac5531ee1e"/>
    <element xsi:type="archimate:Stakeholder" name="Agentes de Campo" id="id-78c61285df7b4e72bb568eb0a4413ae3"/>
    <element xsi:type="archimate:Stakeholder" name="Prefeitura / Gestor Municipal" id="id-21e11d2c5f4b412a90efb3ac03e44d44"/>
    <element xsi:type="archimate:Stakeholder" name="Órgãos de Controle e Ouvidoria" id="id-93b2ef326d844d2db986730eee0674c9"/>
    <element xsi:type="archimate:Driver" name="Demandas urbanas sem acompanhamento pelo cidadão e sem controle de execução em campo" id="id-915cc5726c934947b3fc80f85e2e54e5"/>
    <element xsi:type="archimate:Driver" name="Exigência de eficiência e transparência na gestão pública, com indicadores de desempenho" id="id-ca8a467cd045497c8966613eb4d90cd2"/>
    <element xsi:type="archimate:Goal" name="Registrar e controlar todas as ocorrências urbanas e seu atendimento em um sistema de informação" id="id-a8b0277ddb6d4849b309aaff68c613cd"/>
    <element xsi:type="archimate:Goal" name="Oferecer transparência ao cidadão e à gestão: notificações, indicadores e conformidade com a LGPD" id="id-765ac35378b24a6a9d8f54598c389d70"/>
    <element xsi:type="archimate:Outcome" name="100% das ocorrências registradas com protocolo único" id="id-4362242e132d4c1197ae7c0c9b5c14ac"/>
    <element xsi:type="archimate:Outcome" name="80% das avaliações dos cidadãos com nota 4 ou 5" id="id-044d5cd6c3dc4e5da397e949c88a6a3b"/>
    <element xsi:type="archimate:Outcome" name="70% das ocorrências atendidas dentro do prazo (SLA)" id="id-57494bdb72494292ae709c9cd0926422"/>
    <element xsi:type="archimate:Assessment" name="Criar workflow digital para orientar o fluxo de atendimento, com controle de prazo por etapa" id="id-042f6b957107414f93e0f890803af8c8"/>
    <element xsi:type="archimate:Assessment" name="Enviar pesquisa de satisfação ao cidadão após a conclusão do serviço" id="id-34f640eca71a466c825561d2ea4407b0"/>
    <element xsi:type="archimate:Requirement" name="RF01 - Registrar ocorrência com foto e geolocalização" id="id-8a0231471d9d484c95e9ba8566839529"/>
    <element xsi:type="archimate:Constraint" name="Somente cidadãos autenticados registram ocorrências. Informar categoria, localização (GPS ou endereço) e descrição; até 3 fotos (máx. 5 MB). O sistema gera protocolo único, data/hora e status inicial Aberta." id="id-4bca556ea71d45af9ebb6c921e5f55b6"/>
    <element xsi:type="archimate:Requirement" name="RF02 - Acompanhar status da ocorrência" id="id-6286959ca3a642a88be0c0b6482b68d6"/>
    <element xsi:type="archimate:Constraint" name="Status possíveis: Aberta, Em triagem, Encaminhada, Em execução, Concluída e Rejeitada. Cada mudança de status é gravada em histórico imutável com data e hora." id="id-8376ce61bf9a4fcf9ef341dce90df661"/>
    <element xsi:type="archimate:Requirement" name="RF03 - Triar e encaminhar ocorrências" id="id-2673ebc7449c490183fdd326d491da01"/>
    <element xsi:type="archimate:Constraint" name="O atendente valida os dados, o sistema sinaliza duplicidade (mesma categoria em raio de 50 m) e o atendente define prioridade (Alta, Média, Baixa) e a secretaria responsável." id="id-fef04b96697a4f2ebe200a9117fdd147"/>
    <element xsi:type="archimate:Requirement" name="RF04 - Gerenciar ordens de serviço em campo" id="id-b2b977ef1def46eb95d79015d1eff84e"/>
    <element xsi:type="archimate:Constraint" name="Toda ocorrência encaminhada gera uma OS vinculada a uma equipe. Para concluir a OS, o agente registra a descrição do serviço e anexa foto do serviço executado." id="id-f7e172c86c5a4e35a0b08d782bf36e9b"/>
    <element xsi:type="archimate:Requirement" name="RF05 - Notificar o cidadão a cada mudança de status" id="id-b7aa02fde05e47b986bc950b7fa0ef88"/>
    <element xsi:type="archimate:Constraint" name="Notificação push ou e-mail em toda mudança de status. Ocorrência Concluída solicita avaliação (nota de 1 a 5) em até 7 dias." id="id-5a9e818968bf4db79499d223c8bffa33"/>
    <element xsi:type="archimate:Requirement" name="RF06 - Exibir painel de indicadores" id="id-077b4e27d81642ff8f93077870bc0902"/>
    <element xsi:type="archimate:Constraint" name="Indicadores: tempo médio de atendimento, volume por categoria e bairro, taxa de resolução e satisfação. Acesso restrito ao perfil Gestor." id="id-695a86b6eb494b5d80c46e82ac754ebb"/>
    <element xsi:type="archimate:Requirement" name="RNF01 - LGPD, acessibilidade e disponibilidade" id="id-5b86ef769ec547828f761dfac8c0bc08"/>
    <element xsi:type="archimate:Constraint" name="Consentimento no cadastro, dados mínimos e criptografados, interface WCAG 2.1 AA e disponibilidade mínima de 99,5%." id="id-f3a9a167c35b4be9acae6906e164c9f5"/>
  </folder>
