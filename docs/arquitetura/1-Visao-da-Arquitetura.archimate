<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="CidadeViva - 1 Visao da Arquitetura" id="id-e19288dfb9874a5da20791c307d3addc" version="5.0.0">
  <folder name="Strategy" id="id-32316e217ec94c72a5e6c012ca898b54" type="strategy"/>
  <folder name="Business" id="id-67acf93f4ed5467c9f2157ce37787031" type="business"/>
  <folder name="Application" id="id-6b4b82e9c9d8462f8e73d849827f7101" type="application"/>
  <folder name="Technology &amp; Physical" id="id-e9b3390f10e44c63981b29a3ccb66d22" type="technology"/>
  <folder name="Motivation" id="id-36b9c1fc839948b59f7ce4e2d1006ed3" type="motivation">
    <element xsi:type="archimate:Outcome" name="100% das ocorrências registradas com protocolo único" id="id-783a0d3dd2424e51a4cc8ea503e229d8"/>
    <element xsi:type="archimate:Requirement" name="RF05 - Notificar o cidadão a cada mudança de status" id="id-abbe401c29a04850ab3311b1c5f7f4e3"/>
    <element xsi:type="archimate:Stakeholder" name="Cidadão" id="id-06a79ee677dd4512b9b700d8201c90a9"/>
    <element xsi:type="archimate:Stakeholder" name="Órgãos de Controle e Ouvidoria" id="id-4c8c4f03872e4360bdd2103b523a1ff8"/>
    <element xsi:type="archimate:Stakeholder" name="Prefeitura / Gestor Municipal" id="id-05c0502a16bd4a0ea4570b2c2f2af873"/>
    <element xsi:type="archimate:Constraint" name="Somente cidadãos autenticados registram ocorrências. Informar categoria, localização (GPS ou endereço) e descrição; até 3 fotos (máx. 5 MB). O sistema gera protocolo único, data/hora e status inicial Aberta." id="id-0559e5b1451745caad7d89b4a3eb234b"/>
    <element xsi:type="archimate:Requirement" name="RF01 - Registrar ocorrência com foto e geolocalização" id="id-ded6c9ac903a4789b01c9e9614a12ed7"/>
    <element xsi:type="archimate:Constraint" name="Toda ocorrência encaminhada gera uma OS vinculada a uma equipe. Para concluir a OS, o agente registra a descrição do serviço e anexa foto do serviço executado." id="id-272d19ab015f4b0b93b6cac4d5bc15b4"/>
    <element xsi:type="archimate:Requirement" name="RF06 - Exibir painel de indicadores" id="id-f27f385f751f41e4b94867ce2e8fe1ed"/>
    <element xsi:type="archimate:Requirement" name="RNF01 - LGPD, acessibilidade e disponibilidade" id="id-e71648868cfa4a97972f740f33303ff0"/>
    <element xsi:type="archimate:Assessment" name="Criar workflow digital para orientar o fluxo de atendimento, com controle de prazo por etapa" id="id-2c880693be8b409395c6084d6a59cb6a"/>
    <element xsi:type="archimate:Constraint" name="Notificação push ou e-mail em toda mudança de status. Ocorrência Concluída solicita avaliação (nota de 1 a 5) em até 7 dias." id="id-85f5dadeb1704dffa3751e47bea5a201"/>
    <element xsi:type="archimate:Goal" name="Oferecer transparência ao cidadão e à gestão: notificações, indicadores e conformidade com a LGPD" id="id-26002ecadd824a939e2806d140004664"/>
    <element xsi:type="archimate:Constraint" name="Indicadores: tempo médio de atendimento, volume por categoria e bairro, taxa de resolução e satisfação. Acesso restrito ao perfil Gestor." id="id-ab50c8b7f8b04c0fab30abf375e346be"/>
    <element xsi:type="archimate:Goal" name="Registrar e controlar todas as ocorrências urbanas e seu atendimento em um sistema de informação" id="id-d11827b1c9984c59afeb92de236ceeb9"/>
    <element xsi:type="archimate:Outcome" name="70% das ocorrências atendidas dentro do prazo (SLA)" id="id-1c9927cd23374fa7a7e6eedc4617c9df"/>
    <element xsi:type="archimate:Constraint" name="O atendente valida os dados, o sistema sinaliza duplicidade (mesma categoria em raio de 50 m) e o atendente define prioridade (Alta, Média, Baixa) e a secretaria responsável." id="id-acfb694616954765be9bcce99d812d97"/>
    <element xsi:type="archimate:Driver" name="Exigência de eficiência e transparência na gestão pública, com indicadores de desempenho" id="id-9f41576ff53f49d0b6eb99b70b2986b5"/>
    <element xsi:type="archimate:Stakeholder" name="Agentes de Campo" id="id-044599631c0f4c06ba4e9032ee5abd3b"/>
    <element xsi:type="archimate:Assessment" name="Enviar pesquisa de satisfação ao cidadão após a conclusão do serviço" id="id-8189a62268574b8a9a3cafcf76c03ae9"/>
    <element xsi:type="archimate:Constraint" name="Status possíveis: Aberta, Em triagem, Encaminhada, Em execução, Concluída e Rejeitada. Cada mudança de status é gravada em histórico imutável com data e hora." id="id-e68b2d290e5947f891c6575d317b0f52"/>
    <element xsi:type="archimate:Requirement" name="RF03 - Triar e encaminhar ocorrências" id="id-4a3ccb912064463b9393d8f8d47a56bf"/>
    <element xsi:type="archimate:Outcome" name="80% das avaliações dos cidadãos com nota 4 ou 5" id="id-6fe014e0571f43939750fd7fa2166713"/>
    <element xsi:type="archimate:Constraint" name="Consentimento no cadastro, dados mínimos e criptografados, interface WCAG 2.1 AA e disponibilidade mínima de 99,5%." id="id-3028af3337ab43eba1f1f5f80a9e2ae4"/>
    <element xsi:type="archimate:Requirement" name="RF02 - Acompanhar status da ocorrência" id="id-18945ece204c46c1b127f51a155e0750"/>
    <element xsi:type="archimate:Requirement" name="RF04 - Gerenciar ordens de serviço em campo" id="id-3291bbefba784f1f92c45b16398a0a31"/>
    <element xsi:type="archimate:Driver" name="Demandas urbanas sem acompanhamento pelo cidadão e sem controle de execução em campo" id="id-baa703d609694201ab1434039cbf753e"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-e974de3d424446738d26b7f5bef96d3b" type="implementation_migration"/>
